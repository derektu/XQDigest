{
  "version": "1.0",

  "app": {
    "logLevel": "info",
    "dataPath": "./data",
    "apiPort": 3579
  },

  "download": {
    "concurrentLimit": 3,
    "retryAttempts": 3,
    "retryDelay": 1000,
    "timeoutMs": 30000
  },

  "llm": {
    "provider": "openai",
    "apiKey": "",
    "model": "gpt-4o-mini",
    "baseUrl": null,
    "summarizationPrompt": "",
    "maxTokens": 4096,
    "temperature": 0.7
  }
}
