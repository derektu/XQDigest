{
  "version": "1.0",

  "app": {
    "logLevel": "info",
    "dataPath": "./data"
  },

  "download": {
    "concurrentLimit": 3,
    "retryAttempts": 3,
    "retryDelay": 1000,
    "timeoutMs": 30000
  },

  "dataSources": [
    {
      "id": "yt-example",
      "type": "youtube",
      "name": "Example YouTube Channel",
      "url": "https://www.youtube.com/@ChannelName",
      "checkInterval": 3600,
      "enabled": true,
      "maxItems": 5,
      "lookbackDays": 7,
      "prompt": ""
    },
    {
      "id": "rss-example",
      "type": "rss",
      "name": "Example RSS Feed",
      "url": "https://example.com/feed/",
      "checkInterval": 3600,
      "enabled": false,
      "maxItems": 10,
      "lookbackDays": 14,
      "prompt": ""
    }
  ],

  "llm": {
    "provider": "openai",
    "apiKey": "",
    "model": "gpt-4o-mini",
    "baseUrl": null,
    "summarizationPrompt": "",
    "maxTokens": 4096,
    "temperature": 0.7
  }
}
