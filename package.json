{
  "name": "xqdigest",
  "version": "0.1.0",
  "description": "XQDigest - 財經資訊自動摘要工具",
  "main": "electron/main.js",
  "scripts": {
    "start": "npm run node:rebuild && node src/index.js",
    "node:rebuild": "npm rebuild better-sqlite3",
    "electron": "electron .",
    "electron:rebuild": "cd node_modules/better-sqlite3 && npx node-gyp rebuild --runtime=electron --target=$(npx electron --version | tr -d v) --dist-url=https://electronjs.org/headers",
    "electron:start": "npm run electron:rebuild && npm run electron",
    "test": "npm run node:rebuild && node --test tests/test-*.js",
    "test:integration": "npm run node:rebuild && node --test tests/integration-*.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.7.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^3.6.0",
    "fs-extra": "^11.2.0",
    "gray-matter": "^4.0.3",
    "openai": "^4.20.0",
    "rss-parser": "^3.13.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^40.4.1"
  }
}
