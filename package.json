{
  "name": "xqdigest",
  "version": "0.2.0",
  "description": "XQDigest - 財經資訊自動摘要工具",
  "main": "electron/main.js",
  "scripts": {
    "start": "npm run node:rebuild && node src/index.js",
    "node:rebuild": "npm rebuild better-sqlite3",
    "renderer:dev": "cd renderer && npx vite",
    "renderer:build": "cd renderer && npx vite build",
    "electron": "electron .",
    "electron:rebuild": "npx @electron/rebuild -m . -o better-sqlite3",
    "electron:dev": "VITE_DEV_SERVER_URL=http://localhost:5173 npm run electron",
    "electron:start": "npm run renderer:build && npm run electron:rebuild && npm run electron",
    "test": "npm run node:rebuild && node --test tests/test-*.js",
    "test:integration": "npm run node:rebuild && node --test tests/integration-*.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.7.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^3.6.0",
    "fs-extra": "^11.2.0",
    "gray-matter": "^4.0.3",
    "openai": "^4.20.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rss-parser": "^3.13.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^40.4.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.23.0",
    "vite": "^5.4.0"
  }
}
